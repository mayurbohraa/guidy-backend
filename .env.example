# MongoDB connection string
DB_URL = "mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# Port the server listens on
PORT = 4000

# Public domain name of the deployment (leave empty for local development)
DomainName = ""

# Secret key used to sign JWT tokens (use a long, random string)
secret_key = your_jwt_secret_key_here
